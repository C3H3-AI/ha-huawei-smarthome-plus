    "set_room_floors": {
      "name": "设置房间楼层",
      "description": "批量设置房间楼层（App 抓包验证；服务端为全量覆盖语义，默认自动合并现有楼层）",
      "fields": {
        "entry_id": {
          "name": "配置条目 ID",
          "description": ""
        },
        "rooms": {
          "name": "房间楼层列表",
          "description": "JSON 数组，每项形如 {\"room_id\":\"...\",\"floor\":\"1F\"}；楼层标签如 1F/2F/B1"
        },
        "home_id": {
          "name": "家庭 ID",
          "description": "留空则取账号首个家庭"
        },
        "merge": {
          "name": "合并现有楼层",
          "description": "默认开启：先读取家庭现有楼层再合并提交，避免清空其他房间；关闭则原样全量提交"
        }

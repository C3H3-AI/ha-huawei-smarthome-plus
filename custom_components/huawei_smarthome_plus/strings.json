      "fields": {
        "entry_id": {
          "name": "配置条目 ID",
          "description": ""
        },
        "scenario_id": {
          "name": "场景 ID",
          "description": ""
        },
        "enabled": {
          "name": "是否启用",
          "description": "true 启用 / false 禁用"
        }
      }

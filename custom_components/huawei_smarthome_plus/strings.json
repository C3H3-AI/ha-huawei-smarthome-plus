{
  "config": {
    "step": {
      "user": {
        "title": "Huawei SmartHome Plus",
        "description": "选择一个已登录的 Huawei SmartHome 账号作为凭证来源。Plus 不会要求输入账号密码。",
        "data": {
          "host_entry_id": "Huawei SmartHome 账号"
        }
      }
    },
    "abort": {
      "no_host_integration": "未找到已配置的 Huawei SmartHome 集成，请先安装并登录原集成。",
      "already_configured": "该账号已添加过 Plus。"
    }
  },
  "services": {
    "list_scenes": {
      "name": "列出场景",
      "description": "列出华为智慧生活账号下的全部场景",
      "fields": {
        "entry_id": {
          "name": "配置条目 ID",
          "description": ""
        },
        "need_check": {
          "name": "校验模式",
          "description": ""
        }
      }
    },
    "create_scene": {
      "name": "创建场景",
      "description": "创建一个新的智慧生活场景",
      "fields": {
        "entry_id": {
          "name": "配置条目 ID",
          "description": ""
        },
        "title": {
          "name": "场景名称",
          "description": ""
        },
        "type": {
          "name": "场景类型",
          "description": "1=手动，3=自动，0=混合；默认 1"
        },
        "home_id": {
          "name": "家庭 ID",
          "description": ""
        },
        "description": {
          "name": "描述",
          "description": ""
        },
        "enabled": {
          "name": "创建后启用",
          "description": ""
        },
        "flow": {
          "name": "流程定义 (flow)",
          "description": "完整 ScenarioInfo JSON（触发器/动作），单条可传对象；留空则为仅「点击卡片」手动触发"
        },
        "card": {
          "name": "卡片附加字段",
          "description": "合并进 scenarioCard 的额外字段（如 logo、roomId）"
        }
      }
    },
    "update_scene": {
      "name": "修改场景",
      "description": "修改场景名称/描述/开关/流程（与 App 编辑保存同接口，先合并再整体回传）",
      "fields": {
        "entry_id": {
          "name": "配置条目 ID",
          "description": ""
        },
        "scenario_id": {
          "name": "场景 ID",
          "description": "从 list_scenes 返回值里取"
        },
        "title": {
          "name": "场景名称",
          "description": ""
        },
        "type": {
          "name": "场景类型",
          "description": "1=手动，3=自动，0=混合"
        },
        "description": {
          "name": "描述",
          "description": ""
        },
        "enabled": {
          "name": "是否启用",
          "description": ""
        },
        "flow": {
          "name": "流程定义 (flow)",
          "description": "完整 ScenarioInfo JSON，传入则整体替换原触发器/动作"
        },
        "card": {
          "name": "卡片附加字段",
          "description": ""
        }
      }
    },
    "delete_scene": {
      "name": "删除场景",
      "description": "永久删除一个场景（不可恢复）",
      "fields": {
        "entry_id": {
          "name": "配置条目 ID",
          "description": ""
        },
